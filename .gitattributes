# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Shell scripts must have LF line endings
*.sh text eol=lf
*.bash text eol=lf

# Go sources and configs
*.go text eol=lf
*.toml text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
Makefile text eol=lf
